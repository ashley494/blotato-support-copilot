{
  "name": "blotato-support-copilot",
  "version": "0.1.0",
  "description": "A support engineer's copilot for the Blotato API: diagnose a customer's setup, catch bad post payloads before they fail, and explain errors in plain words. Ships as a CLI and an MCP server.",
  "type": "module",
  "bin": {
    "blotato-copilot": "dist/src/cli.js",
    "blotato-copilot-mcp": "dist/src/mcp.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "mcp": "node dist/src/mcp.js",
    "mock": "node dist/src/mock-server.js",
    "build:n8n": "node scripts/build-n8n.mjs",
    "n8n:demo": "bash scripts/n8n-demo.sh",
    "n8n:ticket": "bash scripts/n8n-ticket.sh",
    "n8n:ticket:bad": "bash scripts/n8n-ticket.sh \"I keep getting 401 errors\" 401 \"Obviously your key is wrong, read the docs.\"",
    "demo": "npm run build && node dist/src/demo.js",
    "serve": "npm run build && node dist/src/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.0"
  }
}
